# Tistory / Kakao 로그인
KAKAO_EMAIL=your@email.com
KAKAO_PASSWORD=your_password

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=여기에_Azure_OpenAI_API_키
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# 국토교통부 실거래가 API (data.go.kr → "아파트매매 실거래가 상세 자료" 신청, 무료)
# 안전마진 분석 섹션에 사용. 없으면 해당 섹션 자동 생략.
MOLIT_API_KEY=여기에_공공데이터포털_일반인증키_디코딩
